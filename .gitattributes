* text=auto
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
# Windows PowerShell 5.1 scripts are stored with CRLF; project scripts also use UTF-8 BOM.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gz binary
*.zip binary
.gitattributes text eol=lf
.gitignore text eol=lf
