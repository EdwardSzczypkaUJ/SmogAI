# Nie edytuj ręcznie, jeżeli korzystasz z scripts\Setup-All.ps1.
# Katalog projektu jest wykrywany z lokalizacji skryptu; poniższe wartości są opcjonalne.
SMOG_AI_ENV=production
SMOG_AI_PROJECT_ROOT=
SMOG_AI_DATA_ROOT=
SMOG_AI_CONFIG=
SMOG_AI_ENV_FILE=
SMOG_AI_DATABASE_URL=
SMOG_AI_SOURCE_HOST_ID=windows-collector
DISPLAY_TIMEZONE=Europe/Warsaw
LOG_LEVEL=INFO

# ObjectStore / DigitalOcean Spaces (opcjonalny Bridge).
SMOG_AI_OBJECT_STORE_BACKEND=spaces
SPACES_BUCKET=CHANGE_ME
SPACES_REGION=fra1
SPACES_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
SPACES_PREFIX=smog-ai
SPACES_ACCESS_KEY_ID=CHANGE_ME
SPACES_SECRET_ACCESS_KEY=CHANGE_ME
SMOG_AI_TRAINING_INPUT_SOURCE=object_store
SMOG_AI_ALLOW_DATABASE_FALLBACK=false
SMOG_AI_PUBLICATION_TRANSPORT=object_store
SMOG_AI_REQUIRE_PANDERA=true

# Bridge przepływu danych.
# direct_local: trening czyta bezpośrednio lokalną SQLite.
# object_store_roundtrip: lokalna SQLite -> ObjectStore -> lokalny trening.
SMOG_AI_DATA_FLOW_MODE=object_store_roundtrip
SMOG_AI_DATA_FLOW_MIRROR_OPERATIONAL=true
# local | object_store | hybrid
SMOG_AI_GIOS_HISTORY_CACHE_MODE=local
SMOG_AI_GIOS_HISTORY_CACHE_PREFIX=source-cache/gios-history

# Lokalnie budowana mapa całej Polski.
SMOG_AI_HOURLY_FORECASTING_ENABLED=true
SMOG_AI_HOURLY_MAX_HORIZON=48
# HF20: 48 future hours served to the user, with a 12h source-delay buffer.
SMOG_AI_HOURLY_SERVING_HORIZON=48
SMOG_AI_HOURLY_MAX_SOURCE_DELAY=12
SMOG_AI_HOURLY_MAX_MODEL_HORIZON=60
SMOG_AI_SPATIAL_ENABLED=true
SMOG_AI_SPATIAL_ALGORITHM=idw
SMOG_AI_SPATIAL_GRID_RESOLUTION_KM=8

# LLM. Bez klucza automatycznie działa adapter regułowy.
SMOG_AI_LLM_PROVIDER=openai_compatible
SMOG_AI_LLM_MODEL=gpt-4.1-mini
SMOG_AI_LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Langfuse. Bez obu kluczy telemetryka przechodzi w tryb no-op.
# Disabled by default. Set to langfuse only after an explicit privacy/cost decision.
SMOG_AI_OBSERVABILITY_BACKEND=none
SMOG_AI_OBSERVABILITY_ENVIRONMENT=development
SMOG_AI_OBSERVABILITY_RELEASE=1.7.0
SMOG_AI_OBSERVABILITY_FLUSH_ON_REQUEST=false
SMOG_AI_PROMPT_TEMPLATE_VERSION=air-query-v1
SMOG_AI_PROMPT_FEEDBACK_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# MLflow is local-first and disabled by default. No MLflow service is created on
# DigitalOcean unless explicitly requested.
SMOG_AI_MLFLOW_ENABLED=false
SMOG_AI_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
SMOG_AI_MLFLOW_EXPERIMENT=smog-ai-hourly
SMOG_AI_MLFLOW_UI_URL=http://127.0.0.1:5000
SMOG_AI_MLFLOW_PUBLISH_COMPARISON=false

# Token potrzebny tylko przy opcjonalnym adapterze publikacji HTTP.
PUBLISH_API_TOKEN=CHANGE_ME_TO_RANDOM_TOKEN
